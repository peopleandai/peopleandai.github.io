---
layout: base.njk
pageClass: home
---
{% import "macros.njk" as ui %}

<section class="hero">
  <img class="hero-photo" src="/assets/img/hero-photo.jpg" alt="" width="2400" height="1018" fetchpriority="high">
  <div class="container hero-grid">
    <div class="hero-content">
      <h1 class="hero-wordmark">{% include "partials/wordmark.njk" %}</h1>
      <div class="hero-text">
        <p class="eyebrow">{{ site.university | t | safe }} · {{ site.department | t | safe }}</p>
        <div class="hero-cta">
          <a class="btn btn-navy" href="/research/"><span class="l-ko">연구 살펴보기</span><span class="l-en">Explore our research</span> <svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
          <a class="btn btn-outline" href="/join/"><span class="l-ko">함께하기</span><span class="l-en">Join us</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    {{ ui.secTab("연구 분야: 인간-컴퓨터 상호작용, 인간중심 AI", "Research Areas: Human-Computer Interaction, Human-Centered AI") }}
    <div class="card vision">
      <p class="vision-text">{{ research.vision | t | safe }}</p>
      <ul class="values">
        {%- for v in research.values %}
        <li class="value">
          <span class="value-ic bg-{{ v.color }}"><svg class="ic" aria-hidden="true"><use href="#i-{{ v.icon }}"/></svg></span>
          <b>{{ v | t | safe }}</b>
        </li>
        {%- endfor %}
      </ul>
    </div>

    <div class="card pills-grid">
      <div>
        <p class="pills-title t-build">{{ research.build.title | t | safe }}</p>
        <ul class="pills">{% for i in research.build.items %}<li class="chip p-build">{{ i | t | safe }}</li>{% endfor %}</ul>
      </div>
      <div>
        <p class="pills-title t-methods">{{ research.methods.title | t | safe }}</p>
        <ul class="pills">{% for i in research.methods.items %}<li class="chip p-methods">{{ i | t | safe }}</li>{% endfor %}</ul>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="sec-head">
      {{ ui.secTab("진행 중인 연구", "Ongoing Research") }}
      <p class="sec-note">{{ research.open_note | t | safe }}</p>
    </div>
    <div class="topic-grid">
      {%- for tp in research.topics | whereStatus("ongoing") %}
      {{ ui.topicCard(tp) }}
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="card panel">
      <div class="panel-head">
        <h2><span class="l-ko">소식</span><span class="l-en">News</span></h2>
        <a class="text-link" href="/news/"><span class="l-ko">전체 보기</span><span class="l-en">All news</span> <svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
      <ul class="news-list">
        {%- for n in (news | sortNews).slice(0, 3) %}{{ ui.newsItem(n) }}{% endfor %}
      </ul>
    </div>
  </div>
</section>

{% if site.recruiting %}
<section class="section section-tight">
  <div class="container">{{ ui.recruitBox(site) }}</div>
</section>
{% endif %}
