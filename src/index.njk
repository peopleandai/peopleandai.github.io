---
layout: base.njk
pageClass: home
---
{% import "macros.njk" as ui %}

<section class="hero">
  <img class="hero-photo" src="/assets/img/hero-photo.jpg" alt="" width="2400" height="1018" fetchpriority="high">
  <div class="container hero-grid">
    <div class="hero-content">
      <h1 class="hero-wordmark">{% include "partials/wordmark.njk" %}</h1>
      <div class="hero-text">
        <p class="eyebrow">{{ site.university | t | safe }} · {{ site.department | t | safe }}</p>
        <p class="eyebrow">Human-AI Interaction Research</p>
        <div class="hero-cta">
          <a class="btn btn-navy" href="/research/"><span class="l-ko">연구 살펴보기</span><span class="l-en">Explore our research</span> <svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
          <a class="btn btn-outline" href="/join/"><span class="l-ko">함께하기</span><span class="l-en">Join us</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="intro">
      <div class="intro-head">
        <p class="intro-label"><span class="l-ko">연구 분야</span><span class="l-en">Research Areas</span></p>
        <h2 class="intro-areas"><span class="l-ko">인간-컴퓨터 상호작용 (HCI)</span><span class="l-en">Human-Computer Interaction (HCI)</span></h2>
      </div>
      <p class="intro-vision">{{ research.vision | t | safe }}</p>
    </div>
    <ol class="values">
      {%- for v in research.values %}
      <li class="value">
        <span class="value-no">0{{ loop.index }}</span>
        <svg class="ic" aria-hidden="true"><use href="#i-{{ v.icon }}"/></svg>
        <b>{{ v | t | safe }}</b>
      </li>
      {%- endfor %}
    </ol>

    <div class="card panel home-news">
      <div class="panel-head">
        <h2><span class="l-ko">소식</span><span class="l-en">News</span></h2>
        <a class="text-link" href="/news/"><span class="l-ko">전체 보기</span><span class="l-en">All news</span> <svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
      <ul class="news-list">
        {%- for n in (news | sortNews).slice(0, 3) %}{{ ui.newsItem(n) }}{% endfor %}
      </ul>
    </div>
  </div>
</section>

{% if site.recruiting %}
<section class="section section-tight">
  <div class="container">{{ ui.recruitBox(site) }}</div>
</section>
{% endif %}
