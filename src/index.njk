---
layout: base.njk
pageClass: home
---
{% import "macros.njk" as ui %}

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-text">
      <p class="eyebrow">{{ site.university | tk("en") }} · {{ site.department | tk("en") }}</p>
      <h1>{% include "partials/wordmark.njk" %}</h1>
      <p class="hero-full"><span class="c-y">P</span>eople <span class="c-g">AND</span> <span class="c-r">A</span>I Lab</p>
      <div class="hero-field">
        <small><span class="l-ko">연구분야</span><span class="l-en">Research Area</span></small>
        <strong>{{ site.field.ko }} <span>({{ site.field.en }})</span></strong>
        <p class="hero-tagline">{{ site.tagline | t | safe }}</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn-light" href="/research/"><span class="l-ko">연구 살펴보기</span><span class="l-en">Explore our research</span> <svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        <a class="btn btn-ghost" href="/join/"><span class="l-ko">함께하기</span><span class="l-en">Join us</span></a>
      </div>
    </div>
    <div class="hero-art">
      <img src="/assets/img/hero-illustration.jpg" alt="People collaborating with AI in a lab" width="1600" height="1132" fetchpriority="high">
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    {{ ui.secTab("연구 비전", "Vision") }}
    <div class="card vision">
      <p class="vision-en">{{ research.vision.en | safe }}</p>
      <p class="vision-ko">{{ research.vision.ko }}</p>
      <ul class="values">
        {%- for v in research.values %}
        <li class="value">
          <span class="value-ic bg-{{ v.color }}"><svg class="ic" aria-hidden="true"><use href="#i-{{ v.icon }}"/></svg></span>
          <span><b>{{ v.en }}</b><small>{{ v.ko }}</small></span>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="sec-head">
      {{ ui.secTab("진행 중인 연구", "Ongoing Research") }}
      <p class="sec-note">{{ research.open_note | t | safe }}</p>
    </div>
    <div class="topic-grid">
      {%- for tp in research.topics | whereStatus("ongoing") %}
      {{ ui.topicCard(tp) }}
      {%- endfor %}
    </div>

    <div class="card pills-grid" style="margin-top:24px">
      <div>
        <p class="pills-title t-build">{{ research.build.title.en }}<small>{{ research.build.title.ko }}</small></p>
        <ul class="pills">{% for i in research.build.items %}<li class="chip p-build">{{ i.en }} <small>{{ i.ko }}</small></li>{% endfor %}</ul>
      </div>
      <div>
        <p class="pills-title t-methods">{{ research.methods.title.en }}<small>{{ research.methods.title.ko }}</small></p>
        <ul class="pills">{% for i in research.methods.items %}<li class="chip p-methods">{{ i.en }} <small>{{ i.ko }}</small></li>{% endfor %}</ul>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container two-col">
    <div class="card panel">
      <div class="panel-head">
        <h2>News<small>소식</small></h2>
        <a class="text-link" href="/news/"><span class="l-ko">전체 보기</span><span class="l-en">All news</span> <svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
      <ul class="news-list">
        {%- for n in (news | sortNews).slice(0, 3) %}{{ ui.newsItem(n) }}{% endfor %}
      </ul>
    </div>
    <div class="card panel">
      <div class="panel-head">
        <h2>Recent Publications<small>최근 논문</small></h2>
        <a class="text-link" href="/publications/"><span class="l-ko">전체 보기</span><span class="l-en">All papers</span> <svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
      <ul class="pub-list compact">
        {%- for p in (publications | sortPubs).slice(0, 5) %}{{ ui.pub(p, site.highlight_authors) }}{% endfor %}
      </ul>
    </div>
  </div>
</section>

{% if site.recruiting %}
<section class="section" style="padding-top:0">
  <div class="container">{{ ui.recruitBox(site) }}</div>
</section>
{% endif %}
