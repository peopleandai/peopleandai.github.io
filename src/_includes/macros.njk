{#- ───────── 재사용 조각 (pages에서 {% import "macros.njk" as ui %} 로 사용) ───────── -#}

{#- 페이지 상단 제목 띠: ui.pageHero({ko, en} 제목, {ko, en} 설명) -#}
{% macro pageHero(title, lead) %}
<section class="page-hero">
  <div class="container">
    <h1 class="page-title">{{ title | t | safe }}</h1>
    {% if lead %}<p class="page-lead">{{ lead | t | safe }}</p>{% endif %}
  </div>
</section>
{% endmacro %}

{#- 섹션 제목: ui.secTab("한국어 제목", "English title") — 선택한 언어만 보임 -#}
{% macro secTab(ko, en, id) %}
<h2 class="sec-tab"{% if id %} id="{{ id }}"{% endif %}><span class="l-ko">{{ ko }}</span><span class="l-en">{{ en }}</span></h2>
{% endmacro %}

{#- 논문 한 편 -#}
{% macro pub(p, highlight, topics) %}
<li class="pub" data-topics="{{ (p.topics or []) | join(' ') }}" data-type="{{ p.type }}">
  <span class="pub-venue t-{{ p.type or 'conference' }}">{{ p.venue_short or p.year }}</span>
  <div class="pub-main">
    <p class="pub-title">
      {% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}
    </p>
    <p class="pub-authors">{{ p.authors | hl(highlight) | safe }}</p>
    <p class="pub-meta">
      <span class="pub-venue-full">{{ p.venue }}{% if p.year %}, {{ p.year }}{% endif %}</span>
      {% if p.lab %}<span class="chip chip-lab">PANDA Lab</span>{% endif %}
      {% if p.award %}<span class="chip chip-award"><svg class="ic" aria-hidden="true"><use href="#i-award"/></svg>{{ p.award }}</span>{% endif %}
    </p>
    {% if p.url or p.pdf or p.code %}
    <p class="pub-links">
      {% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener"><svg class="ic" aria-hidden="true"><use href="#i-ext"/></svg><span class="l-ko">논문</span><span class="l-en">Paper</span></a>{% endif %}
      {% if p.pdf %}<a href="{{ p.pdf }}" target="_blank" rel="noopener"><svg class="ic" aria-hidden="true"><use href="#i-doc"/></svg>PDF</a>{% endif %}
      {% if p.code %}<a href="{{ p.code }}" target="_blank" rel="noopener"><svg class="ic" aria-hidden="true"><use href="#i-code"/></svg><span class="l-ko">코드</span><span class="l-en">Code</span></a>{% endif %}
    </p>
    {% endif %}
  </div>
</li>
{% endmacro %}

{#- 소식 한 줄 -#}
{% macro newsItem(n) %}
<li class="news-item">
  <time datetime="{{ n.date | isoDate }}">{{ n.date | fmtDate }}</time>
  <div class="news-body">
    <p>{% if n.link %}<a href="{{ n.link }}">{{ n | t | safe }}</a>{% else %}{{ n | t | safe }}{% endif %}</p>
  </div>
</li>
{% endmacro %}

{#- 멤버 카드 -#}
{% macro member(m) %}
<article class="member">
  {% if m.photo %}
  <img class="member-photo" src="/assets/img/people/{{ m.photo }}" alt="{{ m.name | tk('en') }}" loading="lazy" width="160" height="160">
  {% else %}
  <span class="member-photo member-initials" aria-hidden="true">{{ m.name | initials }}</span>
  {% endif %}
  <h3 class="member-name">{{ m.name | t | safe }}</h3>
  {% if m.since %}<p class="member-since"><span class="l-ko">{{ m.since }}년~</span><span class="l-en">since {{ m.since }}</span></p>{% endif %}
  {% if m.now %}<p class="member-since">→ {{ m.now | t | safe }}</p>{% endif %}
  {% if m.interests %}<p class="member-int">{{ m.interests | t | safe }}</p>{% endif %}
  {% if m.email or m.website %}
  <p class="member-links">
    {% if m.email %}<a href="mailto:{{ m.email }}" aria-label="Email"><svg class="ic" aria-hidden="true"><use href="#i-mail"/></svg></a>{% endif %}
    {% if m.website %}<a href="{{ m.website }}" target="_blank" rel="noopener" aria-label="Website"><svg class="ic" aria-hidden="true"><use href="#i-globe"/></svg></a>{% endif %}
  </p>
  {% endif %}
</article>
{% endmacro %}

{#- 학생 모집 배너 -#}
{% macro recruitBox(site) %}
<aside class="recruit-box">
  <div>
    <p class="recruit-title"><span class="l-ko">함께할 학생을 찾습니다</span><span class="l-en">We're recruiting!</span></p>
    <p class="recruit-pos"><span class="l-ko">학부연구생 · 석사과정 상시모집</span><span class="l-en">Undergraduate researchers and M.S. students — open year-round</span></p>
  </div>
  <div class="recruit-actions">
    <a class="btn btn-navy" href="/join/"><span class="l-ko">자세히 보기</span><span class="l-en">Learn more</span> <svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
  </div>
</aside>
{% endmacro %}
