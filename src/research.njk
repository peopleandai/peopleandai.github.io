---
layout: base.njk
permalink: /research/
pageClass: research
title:
  ko: 프로젝트
  en: Projects
---
{% import "macros.njk" as ui %}
{{ ui.pageHero({ko: "프로젝트", en: "Projects"}) }}

<section class="section">
  <div class="container">
    <div class="sec-head">
      {{ ui.secTab("진행 중인 연구", "Ongoing Research") }}
      <p class="sec-note">{{ research.open_note | t | safe }}</p>
    </div>

    {%- for tp in research.topics | whereStatus("ongoing") %}
    {%- set related = (publications | sortPubs | byTopic(tp.id)).slice(0, 4) %}
    <article class="card topic-detail" id="{{ tp.id }}">
      <div class="td-img"><img src="/assets/img/research/{{ tp.image }}" alt="{{ tp.name.en }}" loading="lazy" width="800" height="597"></div>
      <div>
        <h2 class="td-title"><span class="td-label bg-{{ tp.color }}"><svg class="ic" aria-hidden="true"><use href="#i-{{ tp.icon }}"/></svg></span>{{ tp.name | t | safe }}</h2>
        <p class="td-q">{{ tp.question | t | safe }}</p>
        {% if tp.summary %}<p class="td-sum">{{ tp.summary | t | safe }}</p>{% endif %}
        {% if tp.keywords %}<div class="td-keywords">{% for k in tp.keywords %}<span>{{ k }}</span>{% endfor %}</div>{% endif %}
        {% if related.length %}
        <div class="td-pubs">
          <h4><span class="l-ko">관련 논문</span><span class="l-en">Related Publications</span></h4>
          <ul>
            {%- for p in related %}
            <li><b>{{ p.venue_short }}</b>{% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}</li>
            {%- endfor %}
          </ul>
          <p class="td-more"><a class="text-link" href="/publications/#topic={{ tp.id }}"><span class="l-ko">이 주제의 논문 모두 보기</span><span class="l-en">All papers on this topic</span> <svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a></p>
        </div>
        {% endif %}
        {% if tp.links %}
        <div class="td-links">{% for l in tp.links %}<a class="chip" href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }} <svg class="ic" aria-hidden="true"><use href="#i-ext"/></svg></a>{% endfor %}</div>
        {% endif %}
      </div>
    </article>
    {%- endfor %}

    <div class="card open-card">
      <div>
        <h3>{{ research.open_note | t | safe }}</h3>
      </div>
    </div>
  </div>
</section>

{%- set past = research.topics | whereStatus("past") %}
{% if past.length %}
<section class="section">
  <div class="container">
    {{ ui.secTab("이전 연구", "Previous Research") }}
    <div class="past-grid topic-grid">
      {%- for tp in past %}
      <article class="topic-card c-{{ tp.color }}" id="{{ tp.id }}">
        <header class="topic-head"><svg class="ic" aria-hidden="true"><use href="#i-{{ tp.icon }}"/></svg><h3>{{ tp.name | t | safe }}</h3></header>
        <div class="topic-body">
          <p class="topic-q">{{ tp.question | t | safe }}</p>
          {% if tp.summary %}<p class="topic-sum">{{ tp.summary | t | safe }}</p>{% endif %}
          <a class="text-link" href="/publications/#topic={{ tp.id }}"><span class="l-ko">관련 논문 보기</span><span class="l-en">Related papers</span> <svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
{% endif %}
