---
layout: base.njk
permalink: /publications/
pageClass: publications
title:
  ko: 대표 논문
  en: Selected Publications
---
{% import "macros.njk" as ui %}
{%- set scholar = '<a href="https://scholar.google.com/citations?user=C8sYLjMAAAAJ" target="_blank" rel="noopener">Google Scholar</a>' %}
{{ ui.pageHero({ko: "대표 논문", en: "Selected Publications"}, {ko: "전체 목록은 " + scholar + "를 참고해 주세요.", en: "For the full list, please see " + scholar + "."}) }}

{%- set pubs = publications | sortPubs %}
<section class="section">
  <div class="container">
    <div class="filters" role="group" aria-label="Filter by topic">
      <button class="filter" type="button" data-filter="all" aria-pressed="true"><span class="l-ko">전체</span><span class="l-en">All</span><span class="count">{{ pubs.length }}</span></button>
      {%- for tp in research.topics %}
      {%- set n = (pubs | byTopic(tp.id)).length %}
      {% if n %}<button class="filter" type="button" data-filter="{{ tp.id }}" aria-pressed="false">{{ tp.name | t | safe }}<span class="count">{{ n }}</span></button>{% endif %}
      {%- endfor %}
    </div>
    <p class="pub-legend">
      <span class="leg-conference"><span class="l-ko">학회</span><span class="l-en">Conference</span></span>
      <span class="leg-journal"><span class="l-ko">저널</span><span class="l-en">Journal</span></span>
      <span class="leg-workshop"><span class="l-ko">워크숍 · 책 챕터</span><span class="l-en">Workshop · Chapter</span></span>
      <span class="leg-preprint"><span class="l-ko">프리프린트</span><span class="l-en">Preprint</span></span>
    </p>

    {%- for y in pubs | pubYears %}
    <div class="year-group">
      <h2 class="year-label">{{ y }}</h2>
      <ul class="pub-list">
        {%- for p in pubs | byYear(y) %}{{ ui.pub(p, site.highlight_authors) }}{% endfor %}
      </ul>
    </div>
    {%- endfor %}
  </div>
</section>
