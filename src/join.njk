---
layout: base.njk
permalink: /join/
pageClass: join
title:
  ko: 함께하기
  en: Join Us
---
{% import "macros.njk" as ui %}
{{ ui.pageHero({ko: "함께하기", en: "Join Us"}) }}

<section class="section">
  <div class="container">
    <div class="card join-hero-box">
      <div>
        <h2>{{ join.headline | t | safe }}</h2>
        <p class="intro">{{ join.intro | t | safe }}</p>
        <ul class="positions">{% for p in join.positions %}<li class="chip">{{ p | t | safe }}</li>{% endfor %}</ul>
      </div>
      <a class="mail-big" href="mailto:{{ site.email }}?subject=%5BPANDA%20Lab%5D%20">
        <svg class="ic" aria-hidden="true"><use href="#i-mail"/></svg>
        <strong>{{ site.email }}</strong>
        <small><span class="l-ko">메일 보내기</span><span class="l-en">Send an email</span></small>
      </a>
    </div>

    <div class="card apply">
      <h2>{{ join.apply.title | t | safe }}</h2>
      <p>{{ join.apply.text | t | safe }}</p>
      <ol class="steps">{% for i in join.apply.items %}<li><span>{{ i | t | safe }}</span></li>{% endfor %}</ol>
    </div>
  </div>
</section>
